rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} { 
      allow read, write: if false; 
    }

    // Primitive Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email'])
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && (!('role' in data) || (data.role is string && (data.role == 'user' || data.role == 'specialist' || data.role == 'psychologist')))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('gender' in data) || (data.gender is string && (data.gender == 'male' || data.gender == 'female')))
        && (!('age' in data) || (data.age is number && data.age > 0 && data.age <= 120))
        && (!('lang' in data) || (data.lang is string && (data.lang == 'ar' || data.lang == 'en')))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('streak' in data) || (data.streak is number && data.streak >= 0));
    }

    function isValidClinic(data) {
      return data.keys().hasAll(['psychologistId', 'name', 'wilaya', 'address', 'createdAt'])
        && data.keys().size() <= 8
        && data.psychologistId is string && data.psychologistId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.wilaya is string && data.wilaya.size() > 0 && data.wilaya.size() <= 100
        && data.address is string && data.address.size() > 0 && data.address.size() <= 500
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 2000))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['patientId', 'psychologistId', 'patientName', 'patientPhone', 'status', 'createdAt'])
        && data.keys().size() <= 10
        && data.patientId is string
        && data.psychologistId is string
        && data.patientName is string && data.patientName.size() > 0 && data.patientName.size() <= 100
        && data.patientPhone is string && data.patientPhone.size() > 0 && data.patientPhone.size() <= 50
        && (!('testId' in data) || (data.testId is string && data.testId.size() <= 128))
        && (!('date' in data) || (data.date is string && data.date.size() <= 100))
        && data.status is string && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'completed' || data.status == 'cancelled')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidTest(data) {
      return data.keys().hasAll(['nameAr', 'category', 'duration', 'questions', 'isPublished'])
        && data.keys().size() <= 7
        && data.nameAr is string && data.nameAr.size() > 0 && data.nameAr.size() <= 200
        && (!('nameEn' in data) || (data.nameEn is string && data.nameEn.size() <= 200))
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.duration is number && data.duration > 0
        && data.questions is list && data.questions.size() >= 0 && data.questions.size() <= 300
        && (!('scoringRules' in data) || data.scoringRules is map)
        && data.isPublished is bool;
    }

    function isValidTestResult(data) {
      return data.keys().hasAll(['userId', 'testId', 'answers', 'totalScore', 'createdAt'])
        && data.keys().size() <= 8
        && data.userId is string && data.userId == request.auth.uid
        && data.testId is string && data.testId.size() <= 128
        && data.answers is list && data.answers.size() >= 0 && data.answers.size() <= 300
        && (data.answers.size() == 0 || data.answers[0] is number) // Checking list content
        && data.totalScore is number
        && (!('subScores' in data) || data.subScores is map)
        && (!('aiAnalysis' in data) || data.aiAnalysis is map)
        && (!('pdfUrl' in data) || (data.pdfUrl is string && data.pdfUrl.size() <= 500))
        && data.createdAt == request.time;
    }

    // Collections
    
    // Admins Collection
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // Only managed via Firebase Console or Admin SDK
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // No blanket reads
      allow create: if isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && incoming().get('createdAt', request.time) == request.time;
      allow update: if isValidId(userId) && request.auth.uid == userId && isSignedIn() && isValidUser(incoming()) && (
        isAdmin() || 
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'gender', 'age', 'lang', 'streak', 'emailVerified', 'role']))
      );
      allow delete: if false;
    }

    match /clinics/{clinicId} {
      // Anyone can view clinics
      allow get: if isSignedIn() && isValidId(clinicId);
      allow list: if isSignedIn();
      // Only the owning psychologist can create/update their clinic
      allow create: if isValidId(clinicId) && isVerified() && isValidClinic(incoming());
      allow update: if isValidId(clinicId) && isVerified() && request.auth.uid == existing().psychologistId && isValidClinic(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'wilaya', 'address', 'phone', 'bio', 'updatedAt']);
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      // Patient and Psychologist can view appointments involving them
      allow get: if isSignedIn() && isValidId(appointmentId) && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.psychologistId);
      allow list: if isSignedIn() && (request.auth.uid == resource.data.patientId || request.auth.uid == resource.data.psychologistId);
      
      // Patient creates appointment
      allow create: if isValidId(appointmentId) && isVerified() && request.auth.uid == incoming().patientId && isValidAppointment(incoming());
      // Psychologist or Patient can update status, Patient can update notes
      allow update: if isValidId(appointmentId) && isVerified() && isValidAppointment(incoming()) && (
        (request.auth.uid == existing().psychologistId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'date', 'updatedAt'])) ||
        (request.auth.uid == existing().patientId && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'date', 'patientName', 'patientPhone', 'updatedAt']))
      );
      allow delete: if false;
    }

    match /tests/{testId} {
      allow get: if isSignedIn() && isValidId(testId);
      allow list: if isSignedIn() && resource.data.isPublished == true;
      allow create: if isValidId(testId) && isVerified() && isAdmin() && isValidTest(incoming());
      allow update: if isValidId(testId) && isVerified() && isAdmin() && isValidTest(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['nameAr', 'nameEn', 'category', 'duration', 'questions', 'scoringRules', 'isPublished']);
      allow delete: if isVerified() && isAdmin() && isValidId(testId);
    }

    match /testResults/{resultId} {
      allow get: if isSignedIn() && isValidId(resultId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // create requires testing that the test exists. Since get() bypasses security rules, we look at the test.
      // Wait, get() costs money so we must place exists() inside create rule and also it checks testId.
      allow create: if isValidId(resultId) && request.auth.uid == incoming().userId && isValidTestResult(incoming());
      allow update: if isValidId(resultId) && request.auth.uid == existing().userId && isValidTestResult(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['aiAnalysis', 'pdfUrl']) && incoming().testId == existing().testId && incoming().userId == existing().userId && incoming().answers == existing().answers && incoming().totalScore == existing().totalScore;
      allow delete: if false;
    }
  }
}
